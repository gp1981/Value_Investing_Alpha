{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "edgartools": {
      "command": ".venv/bin/python",
      "args": [
        "-m",
        "edgar.ai"
      ],
      "env": {
        "EDGAR_IDENTITY": "${EDGAR_IDENTITY:-Value Investing Screener screener@example.com}"
      }
    }
  }
}
