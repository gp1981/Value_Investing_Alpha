# SEC Edgar Configuration (Required by SEC for identification)
EDGAR_IDENTITY="Your Name your.email@example.com"

# Storage paths to prevent local SSD exhaustion (recommended external drive or dedicated dir)
EDGAR_LOCAL_DATA_DIR="/Volumes/T3/edgartools"
EDGAR_CACHE_DIR="/Volumes/T3/edgartools/cache"

# GitHub Token for Antigravity GitHub MCP Server
GITHUB_PERSONAL_ACCESS_TOKEN="ghp_your_personal_access_token_here"

# Web App Server Settings
API_HOST="127.0.0.1"
API_PORT="8000"
